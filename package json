{
  "name": "cloudflare-store-engine",
  "version": "1.0.0",
  "description": "Multi-Tenant Dynamic E-Commerce & Dual Payment Engine (Midtrans & PayPal) on Cloudflare Workers",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "tail": "wrangler tail",
    "d1:init:local": "wrangler d1 execute store-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute store-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-kv",
    "cloudflare-r2",
    "durable-objects",
    "hono",
    "midtrans",
    "paypal",
    "saas",
    "ecommerce",
    "dynamic-schema"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.84.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}